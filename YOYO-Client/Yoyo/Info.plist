<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.anyan.yoyo</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yoyo</string>
				<string>YOYO</string>
			</array>
		</dict>
	</array>
	<!-- Home screen quick actions are installed in
	     `AppDelegate.installQuickActions()` instead of being declared here.
	     Info.plist shortcut titles are not looked up in Localizable.strings,
	     so a static declaration can only ever carry one language (and did,
	     in fact, ship the raw keys). -->
	<!-- 临时封堵：接入自建 Firebase 前关闭 Crashlytics 崩溃上报。
	     换用自己的 GoogleService-Info.plist 之后，请删除下面这个键以恢复崩溃收集。 -->
	<key>firebase_crashlytics_collection_enabled</key>
	<false/>
	<!-- The app only uses HTTPS via NSURLSession plus Apple's own 
	     Keychain/StoreKit crypto, so it is exempt from export compliance 
	     (EAR 740.17(b)(1) / category 5 part 2 note 4). Declaring it here 
	     stops App Store Connect from asking the same question on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
