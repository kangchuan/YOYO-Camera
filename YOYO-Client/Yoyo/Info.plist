<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.anyan.yoyo</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yoyo</string>
				<string>YOYO</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>video</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>quick_action_video</string>
			<key>UIApplicationShortcutItemType</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).video</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>livephoto</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>quick_action_livephoto</string>
			<key>UIApplicationShortcutItemType</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).livephoto</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>photo</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>quick_action_photo</string>
			<key>UIApplicationShortcutItemType</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).photo</string>
		</dict>
	</array>
	<!-- 临时封堵：接入自建 Firebase 前关闭 Crashlytics 崩溃上报。
	     换用自己的 GoogleService-Info.plist 之后，请删除下面这个键以恢复崩溃收集。 -->
	<key>firebase_crashlytics_collection_enabled</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
